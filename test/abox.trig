    data:ev_20260417_001 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "NuScale Power(SMR)가 미국 핵규제위원회(NRC) 유일 인증 SMR 설계 보유사로, TVA·ENTRA1 Energy와 6GW 규모 SMR 파트너십 체결 및 Ebara Elliott Energy와 산업 공정열 공급 협약 체결. 4월 15일 주가 15% 급등."^^xsd:string ;
        sto:evidenceId "ev_20260417_001"^^xsd:string ;
        sto:mentionsCompany data:company_SMR ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_nuclear_power ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.ibtimes.com.au/smr-stock-surges-15-nuscale-rides-nuclear-renaissance-ai-power-demand-boom-1866664"^^xsd:anyURI ;
        sto:title "SMR Stock Surges 15% as NuScale Rides Nuclear Renaissance and AI Power Demand Boom"^^xsd:string .

    data:ev_20260417_002 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "Snap이 Qualcomm과 다년간 전략적 파트너십 체결하여 Snapdragon 칩 기반 차세대 Spectacles AR 안경 2026년 출시 예정. 인력 16% 감축·AI 기반 비용 절감 계획 발표. 일일 활성 사용자 4억7400만명, 월간 활성 사용자 10억명 근접."^^xsd:string ;
        sto:evidenceId "ev_20260417_002"^^xsd:string ;
        sto:mentionsCompany data:company_SNAP ;
        sto:publishedAt "2026-04-15T08:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_social_platform ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.timothysykes.com/news/snap-inc-snap-news-2026_04_15-2/"^^xsd:anyURI ;
        sto:title "Snap Stock Jumps As Activist Pressure Meets Qualcomm AR Deal"^^xsd:string .

    data:ev_20260417_004 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "Hims & Hers Health이 Novo Nordisk과 파트너십 체결하여 FDA 승인 GLP-1 비만치료제(Ozempic, Wegovy) 자사 플랫폼에서 제공 개시. 복합제형 GLP-1 마케팅 중단 후 정식 허가 의약품으로 전략 전환. 연간 비용 절감 5억달러 이상 목표."^^xsd:string ;
        sto:evidenceId "ev_20260417_004"^^xsd:string ;
        sto:mentionsCompany data:company_HIMS ;
        sto:publishedAt "2026-04-17T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_bio_pharma ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://investors.hims.com/news/news-details/2026/Novo-Nordisks-FDA-Approved-GLP-1s-Now-Available-With-Hims--Hers/default.aspx"^^xsd:anyURI ;
        sto:title "Novo Nordisk's FDA-Approved GLP-1s Now Available With Hims & Hers"^^xsd:string .

    data:ev_20260417_005 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "Bitmine(BMNR)이 2026년 4월 9일 NYSE 메인보드 상장 완료 및 40억달러 자사주매입 발표. ETH 보유량 487만개(이더리움 전체 공급량 4.04%)로 세계 최대 ETH 재무 보유사. MAVAN 이더리움 스테이킹 플랫폼으로 연간 스테이킹 수익 2억1200만달러 창출."^^xsd:string ;
        sto:evidenceId "ev_20260417_005"^^xsd:string ;
        sto:mentionsCompany data:company_BMNR ;
        sto:publishedAt "2026-04-12T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_crypto ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://cryptodaily.co.uk/2026/04/bitmine-immersion-technologies-bmnr-announces-eth-holdings-reach-4875-million-tokens-and-total-crypto-and-total-cash-holdings-of-118-billion"^^xsd:anyURI ;
        sto:title "Bitmine Immersion Technologies ETH Holdings Reach 4.875M Tokens, Uplists to NYSE"^^xsd:string .

    data:ev_20260417_006 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "SoFi Technologies가 기업 고객 대상 법정화폐·암호화폐 통합 뱅킹 플랫폼 'Big Business Banking' 출시. Solana 블록체인 기반 24/7 API 결제 및 FedNow 실시간 이체 지원. 2026년 조정 매출 46.55억달러 목표(전년 대비 30% 성장)."^^xsd:string ;
        sto:evidenceId "ev_20260417_006"^^xsd:string ;
        sto:mentionsCompany data:company_SOFI ;
        sto:publishedAt "2026-04-02T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_crypto ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.businesswire.com/news/home/20260402604776/en/SoFi-Launches-Big-Business-Banking-to-Power-Fiat-and-Crypto-Banking-on-a-Single-Regulated-Platform"^^xsd:anyURI ;
        sto:title "SoFi Launches Big Business Banking to Power Fiat and Crypto Banking on a Single Regulated Platform"^^xsd:string .

    data:ev_20260417_007 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "대한광통신(010170)이 엔비디아가 주목한 광반도체 수혜주로 부각되며 4일 연속 신고가 달성. 북미 AI 데이터센터향 광통신 케이블·모듈 수주가 전년 대비 110% 급증. 2026년 영업이익 100억원 돌파 전망. 광통신 테마 전체 상한가 확산."^^xsd:string ;
        sto:evidenceId "ev_20260417_007"^^xsd:string ;
        sto:mentionsCompany data:company_010170 ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_optical_comm ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.thedailymoney.com/news/articleView.html?idxno=1137057"^^xsd:anyURI ;
        sto:title "[단독] 대한광통신, 북미 수주 110% 폭발 → 2026년 '영업이익 100억' 시대 연다"^^xsd:string .

    data:ev_20260417_008 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "Tesla가 2026년 여름 상해 기가팩토리에서 옵티머스 Gen3 휴머노이드 로봇 양산 개시 예정. 연간 100만대 생산 목표, 판매 가격 2만~3만달러. 기존 Model S/X 생산라인을 로봇 파일럿라인으로 전환. von Neumann 자가복제 로봇 연구도 병행."^^xsd:string ;
        sto:evidenceId "ev_20260417_008"^^xsd:string ;
        sto:mentionsCompany data:company_TSLA ;
        sto:publishedAt "2026-04-14T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_robot ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://247wallst.com/investing/2026/04/14/elon-musks-tesla-exec-shanghai-factory-is-the-key-to-unlocking-robot-mass-production/"^^xsd:anyURI ;
        sto:title "Tesla Optimus 3 Production to Begin Summer 2026 at Shanghai Gigafactory"^^xsd:string .

