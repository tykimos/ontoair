    data:ev_20260418_002 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "D-Wave Quantum(QBTS) 주가 4월 14일~18일 주간 50%+ 급등, $13에서 $22로 상승. NVIDIA Ising 발표의 최대 수혜주로 부상. 플로리다대서양대학(FAU)과 2,000만달러 산업용 최적화 계약 수주. 기록적 현금 보유(8억8,450만달러). Mizuho 목표주가 $31 유지(Outperform), 100%+ 상승 여력 전망."^^xsd:string ;
        sto:evidenceId "ev_20260418_002"^^xsd:string ;
        sto:mentionsCompany data:company_QBTS ;
        sto:publishedAt "2026-04-16T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.fxleaders.com/news/2026/04/16/d-wave-quantum-surges-22-as-nvidias-ising-models-ignite-sector-wide-rally/"^^xsd:anyURI ;
        sto:title "D-Wave Quantum Surges 22% as Nvidia's Ising Models Ignite Sector-Wide Rally"^^xsd:string .

    data:ev_20260418_003 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "NVIDIA Ising 발표에 따른 양자주식 섹터 랠리에서 IonQ 주간 50%+ 급등. IonQ는 원격 양자컴퓨터 두 대 연결 '네트워킹 마일스톤' 달성 발표 및 DARPA 양자컴퓨팅 계약 신규 수주로 이온트랩 방식 상용화 가속화."^^xsd:string ;
        sto:evidenceId "ev_20260418_003"^^xsd:string ;
        sto:mentionsCompany data:company_IONQ,
            data:company_NVDA,
            data:company_QBTS ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.gurufocus.com/news/8799139/nvidia-sparks-quantum-computing-surge-ionq-ionq-and-dwave-quantum-qbts-soar"^^xsd:anyURI ;
        sto:title "NVIDIA Sparks Quantum Computing Surge: IonQ (IONQ) and D-Wave Quantum (QBTS) Soar"^^xsd:string .

    data:ev_20260418_004 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "Rigetti Computing이 108큐비트 Cepheus-1-108Q 시스템 출시. 이전 36큐비트 대비 3배 확장, 99.1% 2큐비트 게이트 충실도. 아마존 Braket 및 자체 Quantum Cloud Services로 접근 가능. 영국 1,000큐비트 이상 시스템에 1억달러 투자 계획 발표. NVIDIA Ising 수혜로 주간 45%+ 급등."^^xsd:string ;
        sto:evidenceId "ev_20260418_004"^^xsd:string ;
        sto:mentionsCompany data:company_RGTI ;
        sto:publishedAt "2026-04-14T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://investors.rigetti.com/news-releases/news-release-details/rigetti-computing-provides-update-108-qubit-system"^^xsd:anyURI ;
        sto:title "RGTI Stock Jumps As New 108-Qubit Quantum System Debuts"^^xsd:string .

    data:ev_20260418_005 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "삼성전자 HBM4 세계 최초 양산 개시로 엔비디아 공급망 재진입 모멘텀. SK하이닉스 4월 15일 +2.99%, 4월 23일 1분기 실적 발표에서 영업이익 40조원 돌파 가능성 제기. 씨티증권 SK하이닉스 목표주가 170만원, 2026년 메모리 시장 '250조 잭팟' 전망."^^xsd:string ;
        sto:evidenceId "ev_20260418_005"^^xsd:string ;
        sto:mentionsCompany data:company_000660,
