    data:ev_20260418_006 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "미국 DOE 에너지장관이 의회에서 '초기 원전 5~10기는 거의 확실히 DOE 대출 지원 대상'이라고 발언, NuScale 자금조달 가시성 향상. Ebara Elliott Energy와 산업용 공정열 고온증기압축기 다년 파트너십 체결(2027년 완료). 뉴잉글랜드 6개 주지사 SMR 공동 지원 서명. 주가 4월 15일 15.56% 급등 후 4월 17일 $12.9 수준."^^xsd:string ;
        sto:evidenceId "ev_20260418_006"^^xsd:string ;
        sto:mentionsCompany data:company_SMR ;
        sto:publishedAt "2026-04-17T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_nuclear_power ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.timothysykes.com/news/nuscale-power-corporation-smr-news-2026_04_17/"^^xsd:anyURI ;
        sto:title "SMR Stock Jumps As DOE Loan Signal Fuels Nuclear Rally"^^xsd:string .

    data:ev_20260418_007 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "AI 가속기·서버 CPU 수요로 FCBGA 패키지기판 구조적 공급 부족 진입 전망(2026년 하반기). MLCC 가격 인상 사이클 진입. 2027년 EPS 22,874원에 글로벌 FCBGA 기업 평균 PER 35.4배 적용하여 목표주가 81만원으로 상향. AI 서버·네트워크·위성 수요 확장으로 중장기 이익 성장 기대."^^xsd:string ;
        sto:evidenceId "ev_20260418_007"^^xsd:string ;
        sto:mentionsCompany data:company_009150 ;
        sto:publishedAt "2026-04-17T09:00:00+09:00"^^xsd:dateTime ;
