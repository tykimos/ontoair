    data:ev_20260417_003 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "MARA Holdings이 BTC 15,133개를 11억달러에 매각해 전환사채 상환 후 AI 인프라(데이터센터 임대) 사업 전환 발표. 현재 BTC 38,689개 보유. 전력용량 1.9GW 데이터센터 임대 목표. 4월 16일 주가 6% 상승."^^xsd:string ;
        sto:evidenceId "ev_20260417_003"^^xsd:string ;
        sto:mentionsCompany data:company_MARA ;
        sto:publishedAt "2026-04-16T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_ai_datacenter,
            data:theme_crypto ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://247wallst.com/investing/2026/04/16/mara-rises-6-bitcoin-miner-turned-ai-infrastructure-play-has-the-market-divided-and-buzzing/"^^xsd:anyURI ;
        sto:title "MARA Rises 6%: Bitcoin Miner Turned AI Infrastructure Play Has the Market Divided and Buzzing"^^xsd:string .

