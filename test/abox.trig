    data:ev_20260417_009 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "NVIDIA 2026 회계연도 4분기 매출 680억달러 달성. Blackwell GPU가 데이터센터 컴퓨트 매출의 약 70% 차지. 하이퍼스케일러가 주간 NVL72 랙(Blackwell GPU 72,000개) 약 1,000개씩 배포. Jensen Huang: 'AI 추론용 thinking machine 시대 개막'. 데이터센터 AI 인프라 핵심 공급사 입지 강화."^^xsd:string ;
        sto:evidenceId "ev_20260417_009"^^xsd:string ;
        sto:mentionsCompany data:company_NVDA ;
        sto:publishedAt "2026-02-25T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_ai_datacenter ;
        sto:sourceType "earnings"^^xsd:string ;
        sto:sourceUrl "https://nvidianews.nvidia.com/news/nvidia-announces-financial-results-for-fourth-quarter-and-fiscal-2026"^^xsd:anyURI ;
        sto:title "NVIDIA Announces Financial Results for Fourth Quarter and Fiscal Year 2026"^^xsd:string .

    data:ev_20260417_010 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "2026년 4월 한국 방산주 강세 속 현대로템이 11.39% 급등. K2 전차 유럽·중동 수출 모멘텀 지속. 한화에어로스페이스·한국항공우주·한화시스템도 동반 강세. 방위산업 ETF(KDEF) 동반 상승."^^xsd:string ;
        sto:evidenceId "ev_20260417_010"^^xsd:string ;
        sto:mentionsCompany data:company_064350 ;
        sto:publishedAt "2026-04-02T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_defense ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://en.sedaily.com/finance/2026/04/02/defense-stocks-soar-on-ceasefire-hopes-lig-nex1-hits-upper"^^xsd:anyURI ;
        sto:title "Defense Stocks Soar on Ceasefire Hopes; LIG Nex1 Hits Upper Limit - Korea"^^xsd:string .

    data:ev_20260418_001 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "엔비디아가 2026년 4월 14일(세계 양자의 날) 오픈소스 양자AI 모델 'Ising'을 출시. Ising Calibration과 Ising Decoding 두 패밀리로 구성되어 양자프로세서 캘리브레이션과 오류 보정 자동화. 기존 대비 2.5배 속도·3배 정확도 향상. Harvard, Cornell, IonQ, IQM 등 주요 기관에서 즉시 채택. IonQ +13.3%, D-Wave +10.3%, Rigetti +8.9% 당일 급등."^^xsd:string ;
        sto:evidenceId "ev_20260418_001"^^xsd:string ;
        sto:mentionsCompany data:company_IONQ,
            data:company_NVDA,
            data:company_QBTS,
            data:company_RGTI ;
        sto:publishedAt "2026-04-14T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_ai_semiconductor,
            data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://nvidianews.nvidia.com/news/nvidia-launches-ising-the-worlds-first-open-ai-models-to-accelerate-the-path-to-useful-quantum-computers"^^xsd:anyURI ;
        sto:title "NVIDIA Launches Ising, the World's First Open AI Models to Accelerate the Path to Useful Quantum Computers"^^xsd:string .

