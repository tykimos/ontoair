    data:ev_20260418_011 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "AI 데이터센터 전력 수요 급증으로 국내 전력설비·전선 관련주 강세. 산일전기는 데이터센터 배전 특수변압기 직접 공급 구조 전환 및 교보증권 2026년 신규수주 7,276억원 전망. 가온전선은 전력 케이블·구리 소재 수요 급증 수혜. 4월 15일 전선 관련주 동반 1.1%+ 상승."^^xsd:string ;
        sto:evidenceId "ev_20260418_011"^^xsd:string ;
        sto:mentionsCompany data:company_011420,
            data:company_048690 ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_power_infra ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.valley.town/space/@ValleyAI_Space/articles/69df5a5e3a3f3588d45535ae"^^xsd:anyURI ;
        sto:title "한국장 전선·전력기기株 AI 전력 인프라 수혜 테마 부상 - 산일전기·가온전선 동반 강세"^^xsd:string .

