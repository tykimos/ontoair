        sto:title "삼성전기(009150) 기업분석 Update - 목표주가 81만원으로 상향"^^xsd:string .

    data:ev_20260418_008 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "알테오젠의 IV→SC 제형변환 플랫폼 ALT-B4(히알루로니다제)가 MSD 등 글로벌 빅파마와 8,675억원 기술수출 계약 성사. 2026년 상반기 코스닥→코스피 이전 상장 완료 계획. 4월 15일 +4.25% 강세. PLATFORMeX 플랫폼 기술 추가 라이선스아웃 파이프라인 다수 보유."^^xsd:string ;
        sto:evidenceId "ev_20260418_008"^^xsd:string ;
