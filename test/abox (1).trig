    data:ev_20260418_009 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "리가켐바이오가 위암·췌장암 관련 CLDN18.2 표적 항체-약물접합체(ADC) LCB02A의 안전성·효능 평가를 위해 미국 FDA에 IND 신청. AACR 2026 학회(4월 17~22일) ADC 기술 발표로 주가 7.5% 급등. 파이안바이오와 신규 기전 항체 도입 계약 체결."^^xsd:string ;
        sto:evidenceId "ev_20260418_009"^^xsd:string ;
        sto:mentionsCompany data:company_141080 ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_bio_pharma ;
        sto:sourceType "disclosure"^^xsd:string ;
        sto:sourceUrl "https://www.hitnews.co.kr/news/articleView.html?idxno=75412"^^xsd:anyURI ;
        sto:title "리가켐바이오 CLDN18.2 표적 ADC LCB02A 미국 FDA IND 신청"^^xsd:string .

    data:ev_20260418_010 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "대한전선이 국내 유일 500kV HVAC 북미 공급 실적 보유사. 충남 당진 해저케이블 1공장 가동 중이며 640kV급 HVDC 해저케이블 2공장 착공(2027년 가동 목표). KB증권 해저케이블 시장 점유율 2026년 4%→2032년 31% 전망. AI 전력망 수요 급증으로 목표주가 상향 잇따라."^^xsd:string ;
        sto:evidenceId "ev_20260418_010"^^xsd:string ;
        sto:mentionsCompany data:company_001440 ;
        sto:publishedAt "2026-04-14T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_power_infra ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://ddakzi.com/%EB%8C%80%ED%95%9C%EC%A0%84%EC%84%A0-%EC%A3%BC%EA%B0%80%EC%A0%84%EB%A7%9D-2026%EB%85%84-%EB%AA%A9%ED%91%9C%EC%A3%BC%EA%B0%80-%EC%83%81%ED%96%A5-%EC%9D%B4%EC%9C%A0%EC%99%80-ai-%EC%A0%84%EB%A0%A5/"^^xsd:anyURI ;
        sto:title "대한전선 해저케이블 2공장 착공 및 AI 전력망 슈퍼사이클 수혜"^^xsd:string .

    data:ev_20260418_012 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "반도체 공정 소재 기업 동진쎄미켐(121600)이 2026년 4월 15일 하루 8.03% 급등. HBM 증산 및 첨단 반도체 공정 확장에 따른 포토레지스트·세정제 등 공정 소재 수요 급증 반영. KOSPI 외국인 매수세 유입으로 반도체 소재주 동반 강세. KOSPI 6,000선 회복."^^xsd:string ;
        sto:evidenceId "ev_20260418_012"^^xsd:string ;
        sto:mentionsCompany data:company_121600 ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_semi_equipment ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.valley.town/space/@ValleyAI_Space/articles/69df5a5e3a3f3588d45535ae"^^xsd:anyURI ;
        sto:title "2026.04.15 한국장 요약 - 동진쎄미켐 8% 급등 등 반도체 소재주 수급 집중"^^xsd:string .

