    data:ev_20260418_051 a sto:Evidence ;
        sto:collectedAt "2026-04-18T19:01:49+09:00"^^xsd:dateTime ;
        sto:contentSummary "Coherent Corp이 OFC 2026(광통신 세계 최대 전시회)에서 800G·1.6T 광트랜시버 등 AI 스케일 광통신 혁신 신제품 대거 공개. AI 데이터센터 인터커넥트 광통신 모듈 시장 핵심 공급사 자리매김, 실리콘 포토닉스 통합 솔루션 출시"^^xsd:string ;
        sto:evidenceId "ev_20260418_051"^^xsd:string ;
        sto:mentionsCompany data:company_COHR ;
        sto:publishedAt "2026-03-25T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_optical_comm ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.coherent.com/news/press-releases/coherent-ai-scale-optical-innovations-ofc-2026"^^xsd:anyURI ;
        sto:title "Coherent to Unveil Breakthrough AI-Scale Optical Innovations at OFC 2026"^^xsd:string .

    data:ev_20260418_052 a sto:Evidence ;
        sto:collectedAt "2026-04-18T19:01:49+09:00"^^xsd:dateTime ;
        sto:contentSummary "Quantum Computing Inc(QUBT)의 Dirac-3 양자 최적화 머신이 Quantum Corridor 상업용 양자 안전 네트워크에 배치 완료. NVIDIA Ising 오픈소스 양자AI 모델 발표 수혜로 주가 30%+ 급등하며 상업용 양자컴퓨팅 조기 배포 실현"^^xsd:string ;
        sto:evidenceId "ev_20260418_052"^^xsd:string ;
        sto:mentionsCompany data:company_QUBT ;
        sto:publishedAt "2026-04-15T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://stockstotrade.com/news/quantum-computing-inc-qubt-news-2026_04_15/"^^xsd:anyURI ;
        sto:title "QUBT Stock Pops As Dirac-3 Quantum Machine Hits Commercial Network"^^xsd:string .

    data:ev_20260418_053 a sto:Evidence ;
        sto:collectedAt "2026-04-18T19:01:49+09:00"^^xsd:dateTime ;
        sto:contentSummary "Viking Therapeutics(VKTX)의 GLP-1/GIP 이중작용제 VK2735 경구용 비만치료제 임상 2상에서 평균 14.7% 체중 감소 달성. 2026년 임상 3상 진입 예정으로 Novo Nordisk·Eli Lilly에 도전하는 차세대 비만치료제 유망 기업으로 주목"^^xsd:string ;
        sto:evidenceId "ev_20260418_053"^^xsd:string ;
        sto:mentionsCompany data:company_VKTX ;
        sto:publishedAt "2026-04-14T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_bio_pharma ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.pharmavoice.com/news/glp-1-pharma-obesity-pill-drug-novo-viking-structure-lilly/808195/"^^xsd:anyURI ;
        sto:title "The leading GLP-1 contenders in pharma's race for an obesity pill"^^xsd:string .

    data:ev_20260418_056 a sto:Evidence ;
        sto:collectedAt "2026-04-18T19:01:49+09:00"^^xsd:dateTime ;
        sto:contentSummary "SK텔레콤이 서울-부산 국가 양자암호통신망 구축 완료, 양자키 분배(QKD) 기반 통신 서비스 상용화. SK퀀텀 자회사를 통한 정부·금융기관 대상 양자보안 서비스 확대, 2026년 양자통신 인프라 투자 지속"^^xsd:string ;
        sto:evidenceId "ev_20260418_056"^^xsd:string ;
        sto:mentionsCompany data:company_017670 ;
        sto:publishedAt "2026-04-08T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://www.sktelecom.com/press/index.do"^^xsd:anyURI ;
        sto:title "SK텔레콤, 국가 양자암호통신망 구축 완료 및 QKD 서비스 상용화"^^xsd:string .

    data:ev_20260418_058 a sto:Evidence ;
        sto:collectedAt "2026-04-18T19:01:49+09:00"^^xsd:dateTime ;
        sto:contentSummary "2026년 HBM 시장에서 SK하이닉스 62% 점유율 독보적 1위 유지, 마이크론이 삼성전자 추월해 2위 등극 전망. 세 회사 모두 NVIDIA 16-Hi HBM4 공급 계약 확보 경쟁 중이며 HBM 전체 공급 부족 지속 전망"^^xsd:string ;
