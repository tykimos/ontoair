    data:ev_20260418_001 a sto:Evidence ;
        sto:collectedAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:contentSummary "엔비디아가 2026년 4월 14일(세계 양자의 날) 오픈소스 양자AI 모델 'Ising'을 출시. Ising Calibration과 Ising Decoding 두 패밀리로 구성되어 양자프로세서 캘리브레이션과 오류 보정 자동화. 기존 대비 2.5배 속도·3배 정확도 향상. Harvard, Cornell, IonQ, IQM 등 주요 기관에서 즉시 채택. IonQ +13.3%, D-Wave +10.3%, Rigetti +8.9% 당일 급등."^^xsd:string ;
        sto:evidenceId "ev_20260418_001"^^xsd:string ;
        sto:mentionsCompany data:company_IONQ,
            data:company_NVDA,
            data:company_QBTS,
            data:company_RGTI ;
        sto:publishedAt "2026-04-14T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_ai_semiconductor,
            data:theme_quantum_computing ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "https://nvidianews.nvidia.com/news/nvidia-launches-ising-the-worlds-first-open-ai-models-to-accelerate-the-path-to-useful-quantum-computers"^^xsd:anyURI ;
        sto:title "NVIDIA Launches Ising, the World's First Open AI Models to Accelerate the Path to Useful Quantum Computers"^^xsd:string .

