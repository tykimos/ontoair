        sto:createdAt "2026-04-18T14:10:00+09:00"^^xsd:dateTime ;
        sto:description "엔비디아가 세계 최초 오픈소스 양자AI 모델 'Ising' 발표 - 양자프로세서 캘리브레이션·오류보정 자동화로 양자컴퓨팅 실용화 가속화"^^xsd:string ;
