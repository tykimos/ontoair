    data:ev_20260417_009 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "NVIDIA 2026 회계연도 4분기 매출 680억달러 달성. Blackwell GPU가 데이터센터 컴퓨트 매출의 약 70% 차지. 하이퍼스케일러가 주간 NVL72 랙(Blackwell GPU 72,000개) 약 1,000개씩 배포. Jensen Huang: 'AI 추론용 thinking machine 시대 개막'. 데이터센터 AI 인프라 핵심 공급사 입지 강화."^^xsd:string ;
        sto:evidenceId "ev_20260417_009"^^xsd:string ;
        sto:mentionsCompany data:company_NVDA ;
        sto:publishedAt "2026-02-25T09:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_ai_datacenter ;
        sto:sourceType "earnings"^^xsd:string ;
        sto:sourceUrl "https://nvidianews.nvidia.com/news/nvidia-announces-financial-results-for-fourth-quarter-and-fiscal-2026"^^xsd:anyURI ;
        sto:title "NVIDIA Announces Financial Results for Fourth Quarter and Fiscal Year 2026"^^xsd:string .

    data:ev_20260417_010 a sto:Evidence ;
