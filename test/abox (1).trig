    data:ev_20260419_005 a sto:Evidence ;
        sto:collectedAt "2026-04-19T14:23:56+09:00"^^xsd:dateTime ;
        sto:contentSummary "넷플릭스가 2026년 4월 16일 1분기 매출 $122.5억(+16% YoY, 예상 $121.8억 상회)·EPS $1.23(예상 $0.76 대비 +62%) 발표. 단, 파라마운트·스카이댄스로부터 수령한 $28억 WBD 계약 해지 수수료 일회성 수익 포함. 2분기 매출 성장률 13% 가이던스는 기대치 대비 보수적이며, 공동창업자 리드 헤이스팅스 이사회 의장 6월 퇴임 발표로 주가 -9% 급락. 연간 가이던스 $507~517억 유지."^^xsd:string ;
        sto:evidenceId "ev_20260419_005"^^xsd:string ;
        sto:mentionsCompany data:company_NFLX ;
        sto:publishedAt "2026-04-16T23:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_streaming_media ;
        sto:sourceType "earnings"^^xsd:string ;
        sto:sourceUrl "https://www.cnbc.com/2026/04/16/netflix-nflx-earnings-q1-2026.html"^^xsd:anyURI ;
        sto:title "Netflix Q1 2026 실적 발표: 매출 $122.5억(+16% YoY) 서프라이즈, 헤이스팅스 이사회 퇴임에 주가 -9%"^^xsd:string .

    data:evt_20260419_004 a sto:Event ;
        sto:createdAt "2026-04-19T14:23:56+09:00"^^xsd:dateTime ;
        sto:description "넷플릭스 2026년 1분기 실적 발표: 매출 $122.5억(+16% YoY), EPS $1.23 어닝 서프라이즈에도 헤이스팅스 이사회 퇴임·2분기 가이던스 부진으로 주가 -9% 급락"^^xsd:string ;
