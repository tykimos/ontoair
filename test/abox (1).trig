    data:ev_20260417_004 a sto:Evidence ;
        sto:collectedAt "2026-04-18T05:31:19+09:00"^^xsd:dateTime ;
        sto:contentSummary "Hims & Hers Health이 Novo Nordisk과 파트너십 체결하여 FDA 승인 GLP-1 비만치료제(Ozempic, Wegovy) 자사 플랫폼에서 제공 개시. 복합제형 GLP-1 마케팅 중단 후 정식 허가 의약품으로 전략 전환. 연간 비용 절감 5억달러 이상 목표."^^xsd:string ;
