    data:ev_20260419_004 a sto:Evidence ;
        sto:collectedAt "2026-04-19T14:23:56+09:00"^^xsd:dateTime ;
        sto:contentSummary "빛샘전자(072950)가 2026년 4월 14일 기준 3연속 상한가(+29.96%)를 기록하며 엔비디아 CPO(공동 패키지 광학, Co-Packaged Optics) 광동맹 핵심 수혜주로 부상. 미국 빅테크의 AI 데이터센터 광통신 병목 해소를 위한 실리콘 포토닉스 대규모 투자 흐름과 6G 시연 원년 이슈가 맞물려 역대급 신고가 랠리. 증권사 Buy 추천 및 목표주가 13,400원 제시 후 주가 18,220원까지 재차 급등."^^xsd:string ;
        sto:evidenceId "ev_20260419_004"^^xsd:string ;
        sto:mentionsCompany data:company_072950 ;
        sto:publishedAt "2026-04-14T16:00:00+09:00"^^xsd:dateTime ;
        sto:relatesToTheme data:theme_optical_comm ;
        sto:sourceType "news"^^xsd:string ;
        sto:sourceUrl "http://www.thedailymoney.com/news/articleView.html?idxno=1137546"^^xsd:anyURI ;
        sto:title "빛샘전자, 엔비디아 CPO 광동맹 핵심 수혜주로 3연속 상한가·신고가 랠리"^^xsd:string .

