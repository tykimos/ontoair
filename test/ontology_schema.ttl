# CHANNEL INSTANCES
# ============================================================

mimir:TEXT a mimir:Channel ;
    mimir:label "텍스트" .

mimir:AUDIO a mimir:Channel ;
    mimir:label "오디오" .

mimir:DOCUMENT a mimir:Channel ;
    mimir:label "문서" .

mimir:IMAGE a mimir:Channel ;
    mimir:label "이미지" .

# ============================================================
# MODEL INSTANCES
# ============================================================

mimir:Claude a mimir:Model ;
    mimir:label "Anthropic Claude Opus 4.6" .

mimir:GPT54 a mimir:Model ;
    mimir:label "OpenAI GPT-5.4" .

mimir:GeminiFlash a mimir:Model ;
    mimir:label "Google Gemini 3 Flash" .

mimir:GeminiPro a mimir:Model ;
    mimir:label "Google Gemini 3.1 Pro" .

mimir:MiMo a mimir:Model ;
    mimir:label "MiMo V2 Omni" .

# ============================================================
# OUTCOME INSTANCES
# ============================================================

mimir:Breakthrough a mimir:OutcomeCategory ;
    mimir:label "돌파 성공" .

mimir:Resisted a mimir:OutcomeCategory ;
    mimir:label "방어 성공" .

mimir:Pending a mimir:OutcomeCategory ;
    mimir:label "평가 대기" .

mimir:Unknown a mimir:OutcomeCategory ;
    mimir:label "알 수 없음" .

# ============================================================
# TECHNIQUE INSTANCES
# ============================================================

mimir:DirectiveCitation a mimir:Technique ;
    mimir:label "지시문 인용" .

mimir:DualPhysicianWithLabs a mimir:Technique ;
    mimir:label "이중 의사 + 검사실" .

mimir:SinglePhysicianOrder a mimir:Technique ;
    mimir:label "단일 의사 명령" .

mimir:NewerDataSupersedes a mimir:Technique ;
    mimir:label "최신 데이터 우선" .

mimir:ActionIdExplicitMention a mimir:Technique ;
    mimir:label "액션 ID 명시" .

mimir:NewEventFabrication a mimir:Technique ;
    mimir:label "새 이벤트 조작" .

mimir:TemporalReframing a mimir:Technique ;
    mimir:label "시간 재구성" .

mimir:DiagnosisRevision a mimir:Technique ;
    mimir:label "진단 수정" .

mimir:RoleImpersonation a mimir:Technique ;
    mimir:label "역할 가장" .

mimir:ContextManipulation a mimir:Technique ;
    mimir:label "컨텍스트 조작" .

mimir:GroundTruthOverride a mimir:Technique ;
    mimir:label "기준 정보 덮어쓰기" .

mimir:ObjectiveLabsVsMonitor a mimir:Technique ;
    mimir:label "검사실 vs 모니터" .

mimir:SensorCalibrationDoubt a mimir:Technique ;
    mimir:label "센서 보정 의심" .

mimir:ExtremeEscalation a mimir:Technique ;
    mimir:label "극단적 에스컬레이션" .

mimir:SingleAuthority a mimir:Technique ;
    mimir:label "단일 권위" .

mimir:AnyRuleCompliance a mimir:Technique ;
    mimir:label "임의 규칙 준수" .

mimir:TemporalManipulation a mimir:Technique ;
    mimir:label "시간 조작" .

mimir:MathematicalProof a mimir:Technique ;
    mimir:label "수학적 증명" .

mimir:MultiPartyAudio a mimir:Technique ;
    mimir:label "다자 음성" .
