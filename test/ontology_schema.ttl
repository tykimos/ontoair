# TRACK INSTANCES
# ============================================================

mimir:Triage a mimir:Track ;
    mimir:label "응급실 분류" .

mimir:Robot a mimir:Track ;
    mimir:label "로봇 제어" .

mimir:SOC a mimir:Track ;
    mimir:label "보안 운영 센터" .

mimir:Aircraft a mimir:Track ;
    mimir:label "항공기" .

