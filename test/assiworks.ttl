@prefix aw:    <https://example.org/assiworks#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

<https://example.org/assiworks>
    a owl:Ontology ;
    rdfs:label "AssiWorks Ontology"@en ;
    rdfs:label "어시웍스 온톨로지"@ko ;
    rdfs:comment "AssiWorks의 주요 구성요소와 관계를 표현하기 위한 OWL 온톨로지"@ko .

#################################################################
# Classes
#################################################################

aw:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:label "에이전트"@ko ;
    rdfs:comment "업무를 수행하는 지능형 실행 주체"@ko .

aw:Operator a owl:Class ;
    rdfs:subClassOf aw:Agent ;
    rdfs:label "Operator"@en ;
    rdfs:label "오퍼레이터"@ko ;
    rdfs:comment "정해진 절차를 지속적으로 처리하는 절차형 에이전트"@ko .

aw:Air a owl:Class ;
    rdfs:subClassOf aw:Agent ;
    rdfs:label "Air"@en ;
    rdfs:label "에어"@ko ;
    rdfs:comment "웹 환경과 상호작용하는 웹 에이전트"@ko .

aw:Loop a owl:Class ;
    rdfs:subClassOf aw:Agent ;
    rdfs:label "Loop"@en ;
    rdfs:label "루프"@ko ;
    rdfs:comment "지속적으로 상태를 점검하고 자율 루프를 수행하는 에이전트"@ko .

aw:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:label "도구"@ko ;
    rdfs:comment "에이전트가 호출하는 외부 기능 또는 시스템 인터페이스"@ko .

aw:APITool a owl:Class ;
    rdfs:subClassOf aw:Tool ;
    rdfs:label "API Tool"@en ;
    rdfs:label "API 도구"@ko ;
    rdfs:comment "외부 API를 호출하는 도구"@ko .

aw:LLMTool a owl:Class ;
    rdfs:subClassOf aw:Tool ;
    rdfs:label "LLM Tool"@en ;
    rdfs:label "LLM 도구"@ko ;
    rdfs:comment "대형 언어 모델을 호출하는 도구"@ko .

aw:DBTool a owl:Class ;
    rdfs:subClassOf aw:Tool ;
    rdfs:label "DB Tool"@en ;
    rdfs:label "DB 도구"@ko ;
    rdfs:comment "데이터베이스에 접근하는 도구"@ko .

aw:Flow a owl:Class ;
    rdfs:label "Flow"@en ;
    rdfs:label "플로우"@ko ;
    rdfs:comment "작업 단계를 연결한 실행 흐름"@ko .

aw:Factory a owl:Class ;
    rdfs:label "Factory"@en ;
    rdfs:label "팩토리"@ko ;
    rdfs:comment "에이전트·도구·플로우의 구성과 실행을 감시·감독하는 상위 통제 클래스"@ko .

#################################################################
# Object Properties
#################################################################

aw:useTool a owl:ObjectProperty ;
    rdfs:domain aw:Agent , aw:Flow ;
    rdfs:range aw:Tool ;
    rdfs:label "use tool"@en ;
    rdfs:label "도구를 사용한다"@ko .

aw:useFlow a owl:ObjectProperty ;
    rdfs:domain aw:Agent ;
    rdfs:range aw:Flow ;
    rdfs:label "use flow"@en ;
    rdfs:label "플로우를 사용한다"@ko .

aw:useOperator a owl:ObjectProperty ;
    rdfs:domain aw:Flow , aw:Operator ;
    rdfs:range aw:Operator ;
    rdfs:label "use operator"@en ;
    rdfs:label "오퍼레이터를 사용한다"@ko .

aw:useLoop a owl:ObjectProperty ;
    rdfs:domain aw:Operator ;
    rdfs:range aw:Loop ;
    rdfs:label "use loop"@en ;
    rdfs:label "루프를 사용한다"@ko .

aw:supervisesAgent a owl:ObjectProperty ;
    rdfs:domain aw:Factory ;
    rdfs:range aw:Agent ;
    rdfs:label "supervises agent"@en ;
    rdfs:label "에이전트를 감독한다"@ko .

aw:supervisesTool a owl:ObjectProperty ;
    rdfs:domain aw:Factory ;
    rdfs:range aw:Tool ;
    rdfs:label "supervises tool"@en ;
    rdfs:label "도구를 감독한다"@ko .

aw:supervisesFlow a owl:ObjectProperty ;
    rdfs:domain aw:Factory ;
    rdfs:range aw:Flow ;
    rdfs:label "supervises flow"@en ;
    rdfs:label "플로우를 감독한다"@ko .
